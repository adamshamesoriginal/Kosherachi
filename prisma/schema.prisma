generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Schema pushes (CREATE TABLE etc.) need a direct connection — Neon's
  // pooled endpoint (what DATABASE_URL should be, for the running app)
  // doesn't support DDL. DIRECT_URL must be set to Neon's non-pooled
  // connection string (same as DATABASE_URL if you're not using a pooler).
  directUrl = env("DIRECT_URL")
}

model Restaurant {
  id                  String   @id @default(cuid())
  published           Boolean  @default(true)
  name                String
  imageUrl            String
  logoUrl             String
  cuisine             String // comma-separated
  area                String
  address             String
  foodTypes           String // comma-separated FoodType values
  rating              Float
  reviewCount         Int
  deliveryTimeMinLow  Int
  deliveryTimeMinHigh Int
  deliveryFee         Float
  minOrder            Float
  selfDelivery        Boolean

  kashrutLevel           String
  certifyingBody         String
  certificateNumber      String
  certificateIssuedDate  DateTime
  certificateExpiryDate  DateTime
  certificateImageUrl    String
  certificateVerified    Boolean

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  menuItems           MenuItem[]
  reviews             Review[]
  orders              Order[]
  partnerApplications PartnerApplication[]

  @@index([ownerId])
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String
  price        Float
  imageUrl     String
  foodType     String
  category     String
  popular      Boolean    @default(false)
  available    Boolean    @default(true)

  options    MenuItemOption[]
  orderItems OrderItem[]
}

// A customization group for a menu item, e.g. "תוספות" (multi-select
// add-ons) or "רמת חריפות" (single-select). Optional — most items have none.
model MenuItemOption {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  type       String // "single" | "multi"
  required   Boolean  @default(false)
  sortOrder  Int      @default(0)

  choices MenuItemOptionChoice[]

  @@index([menuItemId])
}

model MenuItemOptionChoice {
  id         String         @id @default(cuid())
  optionId   String
  option     MenuItemOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label      String
  priceDelta Float          @default(0)
  sortOrder  Int            @default(0)

  @@index([optionId])
}

model Review {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userName     String
  rating       Int
  comment      String
  date         DateTime
}

model Order {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantName    String
  subtotal          Float
  deliveryFee       Float
  serviceFee        Float
  vat               Float
  total             Float
  address           String
  phone             String
  pickupOrDelivery  String
  note              String? // general instructions for the whole order, e.g. "בבקשה לצלצל בפעמון"
  status            String   @default("placed")
  createdAt         DateTime @default(now())

  // Payment is separate from fulfillment status above: an order exists (and
  // is visible to its customer) before payment completes, but shouldn't
  // reach the restaurant's queue until paymentStatus is confirmed paid by
  // the provider's async webhook — never by trusting the browser redirect.
  paymentStatus        String  @default("pending") // pending | paid | failed | refunded
  paymentProvider      String? // "meshulam"
  paymentTransactionId String? @unique // Meshulam's process/transaction id, used to match the webhook back to this order

  items OrderItem[]

  @@index([userId])
  @@index([paymentStatus])
}

model User {
  id        String    @id @default(cuid())
  phone     String?   @unique
  email     String?   @unique
  googleId  String?   @unique
  appleId   String?   @unique
  name      String?
  createdAt DateTime  @default(now())

  sessions            Session[]
  orders              Order[]
  ownedRestaurants    Restaurant[]
  partnerApplications PartnerApplication[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([phone])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float // per-unit price, including any selected option price deltas
  quantity   Int
  note       String? // e.g. "בלי בצל"

  // Snapshot of the chosen options at order time (JSON array of
  // { optionName, choiceLabel, priceDelta }) — kept as a snapshot rather
  // than a live relation because the owner can edit/delete options later
  // and past orders must keep showing what was actually selected.
  selectedOptionsJson String?
}

model PartnerApplication {
  id              String    @id @default(cuid())
  applicantUserId String
  applicant       User      @relation(fields: [applicantUserId], references: [id])
  businessName    String
  businessId      String
  area            String
  status          String    @default("pending") // pending | approved | rejected
  reviewNote      String?
  restaurantId    String?
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  @@index([applicantUserId])
  @@index([status])
}
