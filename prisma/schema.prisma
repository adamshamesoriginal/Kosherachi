generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Restaurant {
  id                  String   @id @default(cuid())
  published           Boolean  @default(true)
  name                String
  imageUrl            String
  logoUrl             String
  cuisine             String // comma-separated
  area                String
  address             String
  foodTypes           String // comma-separated FoodType values
  rating              Float
  reviewCount         Int
  deliveryTimeMinLow  Int
  deliveryTimeMinHigh Int
  deliveryFee         Float
  minOrder            Float
  selfDelivery        Boolean

  kashrutLevel           String
  certifyingBody         String
  certificateNumber      String
  certificateIssuedDate  DateTime
  certificateExpiryDate  DateTime
  certificateImageUrl    String
  certificateVerified    Boolean

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  menuItems           MenuItem[]
  reviews             Review[]
  orders              Order[]
  partnerApplications PartnerApplication[]

  @@index([ownerId])
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String
  price        Float
  imageUrl     String
  foodType     String
  category     String
  popular      Boolean    @default(false)
  available    Boolean    @default(true)

  orderItems OrderItem[]
}

model Review {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userName     String
  rating       Int
  comment      String
  date         DateTime
}

model Order {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantName    String
  subtotal          Float
  deliveryFee       Float
  serviceFee        Float
  vat               Float
  total             Float
  address           String
  phone             String
  pickupOrDelivery  String
  status            String   @default("placed")
  createdAt         DateTime @default(now())

  items OrderItem[]

  @@index([userId])
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  createdAt DateTime  @default(now())

  sessions            Session[]
  orders              Order[]
  ownedRestaurants    Restaurant[]
  partnerApplications PartnerApplication[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([phone])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  quantity   Int
}

model PartnerApplication {
  id              String    @id @default(cuid())
  applicantUserId String
  applicant       User      @relation(fields: [applicantUserId], references: [id])
  businessName    String
  businessId      String
  area            String
  status          String    @default("pending") // pending | approved | rejected
  reviewNote      String?
  restaurantId    String?
  restaurant      Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?

  @@index([applicantUserId])
  @@index([status])
}
